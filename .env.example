# ── Core ────────────────────────────────────────────────
RESONANCE_ENV=development
RESONANCE_SECRET_KEY=change-me-to-64-random-bytes-hex
RESONANCE_LOG_LEVEL=debug

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resonance
POSTGRES_USER=resonance
POSTGRES_PASSWORD=change-me

TEST_POSTGRES_DB=resonance_test

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ─────────────────────────────────────────────────
# JWT_ACCESS_TTL=900          # 15 minutes
# JWT_REFRESH_TTL=2592000     # 30 days
JWT_ISSUER=resonance

# ── Media ───────────────────────────────────────────────
# ── Host paths (bind mounts for docker compose) ─────────
# The host directory that contains your music library.
# It is mounted read-only into the backend container at /media.
# Use an absolute path on the host machine.
MEDIA_ROOT=/absolute/path/to/your/music

# Where to store extracted album covers (host path).
# Inside Docker, this is replaced by a named volume at /data/covers.
COVER_CACHE_DIR=/absolute/path/to/resonance/backend/data/covers
TRANSCODE_CACHE_DIR=/absolute/path/to/resonance/backend/data/transcodes

# Where to store podacts trackers
PODCAST_CACHE_DIR=absolute/path/to/resonance/backend/data/podcasts

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-64-random-bytes-hex
JWT_ACCESS_TTL=900          # 15 min
JWT_REFRESH_TTL=2592000     # 30 days
ALLOW_REGISTRATION=1        # set to 0 to disable public signup
ARGON2_MEMORY=32M
ARGON2_TIME=3
ARGON2_PARALLELISM=1

# ── APP ────────────────────────────────────────────────
APP_NAME=Resonance
APP_COPYRIGHT_YEAR=2026
ADMIN_CONTACT=admin@example.com
