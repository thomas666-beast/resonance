# ── Core ────────────────────────────────────────────────
RESONANCE_ENV=development
RESONANCE_SECRET_KEY=change-me-to-64-random-bytes-hex
RESONANCE_LOG_LEVEL=debug

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resonance
POSTGRES_USER=resonance
POSTGRES_PASSWORD=change-me

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ─────────────────────────────────────────────────
# JWT_ACCESS_TTL=900          # 15 minutes
# JWT_REFRESH_TTL=2592000     # 30 days
JWT_ISSUER=resonance

# ── Media ───────────────────────────────────────────────
MEDIA_ROOT=/srv/media

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=change-me-to-64-random-bytes-hex
JWT_ACCESS_TTL=900          # 15 min
JWT_REFRESH_TTL=2592000     # 30 days
ALLOW_REGISTRATION=1        # set to 0 to disable public signup
ARGON2_MEMORY=32M
ARGON2_TIME=3
ARGON2_PARALLELISM=1