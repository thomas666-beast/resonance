#!/usr/bin/env perl
use strict;
use warnings;
use Audio::Scan;

my $file = shift @ARGV or die "Usage: $0 <audio-file>\n";
die "File not found: $file\n" unless -e $file;

my $info = Audio::Scan->scan($file);
my $tags = $info->{tags} // {};
my $audio = $info->{info} // {};

print "File: $file\n";
print "── Tags ──\n";
for my $k (sort keys %$tags) {
    my $v = $tags->{$k};
    $v = "(array) " . join(", ", @$v) if ref $v eq 'ARRAY';
    print "  $k = $v\n";
}
print "── Audio info ──\n";
for my $k (sort keys %$audio) {
    print "  $k = $audio->{$k}\n";
}
